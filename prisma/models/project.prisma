enum Role {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id             String         @id @default(cuid())
  clerkId        String         @unique
  email          String         @unique
  name           String?
  imageUrl       String?
  defaultModel   String? // "provider:modelId", e.g. "anthropic:claude-opus-4-8"
  customInstructions String? // user-layer prompt, APPENDED to AI system prompts (never replaces the base contract)
  ownedProjects  Project[]
  collaborations Collaborator[]
  apiKeys        UserApiKey[]
  templates      CanvasTemplate[]
  feedback       Feedback[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // anthropic | openai | google
  encryptedKey String // AES-256-GCM, never returned to the client
  last4        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

model Project {
  id             String         @id @default(cuid())
  name           String         @default("Untitled Project")
  description    String?
  canvasJsonPath String?
  thumbnailUrl   String?
  shareToken     String?  @unique
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaborators  Collaborator[]
  generations    AIGeneration[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
}

model Collaborator {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  role      Role     @default(EDITOR)
  title     String? // free-text discipline/role set by the owner (e.g. "Backend Lead", "Security")
  createdAt DateTime @default(now())

  @@unique([projectId, email])
  @@index([userId])
  @@index([projectId])
}

model AIGeneration {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prompt    String
  type      String   @default("generation") // generation | url-analysis | critique | refinement
  status    String   @default("pending")    // pending | running | completed | failed
  result    Json?
  error     String?
  rating    Int?     // user feedback: 1 (up) | -1 (down)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/**
 * User-saved canvas templates.
 * isPublic=true → visible in the template picker to all users.
 * isPublic=false → private, only visible to the creator.
 */
model CanvasTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String   @default("custom")  // web | data | infra | mobile | custom
  isPublic    Boolean  @default(false)
  schema      Json     // spi-schema.json structure
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isPublic])
}

/**
 * User-submitted feedback (bugs, complaints, ideas). Surfaced on /admin where
 * the status moves open → in_progress → resolved.
 */
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // bug | complaint | idea | other
  message   String
  path      String? // page the user was on when they sent it
  status    String   @default("open") // open | in_progress | resolved
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

/**
 * Product usage events for activation/retention metrics (own-DB, independent of
 * any analytics vendor). Generation events live in AIGeneration; this records
 * the rest of the value funnel.
 */
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String // kit_generated | spec_exported | png_exported | mermaid_exported | bundle_exported | share_invited | onboarding_done | checklist_step | palette_used | domain_selected
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([type, createdAt])
}

model TaskRun {
  id        String   @id @default(cuid())
  runId     String   @unique
  projectId String
  userId    String
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([projectId, userId])
}
