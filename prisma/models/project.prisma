enum Role {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id             String         @id @default(cuid())
  clerkId        String         @unique
  email          String         @unique
  name           String?
  imageUrl       String?
  defaultModel   String? // "provider:modelId", e.g. "anthropic:claude-opus-4-8"
  ownedProjects  Project[]
  collaborations Collaborator[]
  apiKeys        UserApiKey[]
  templates      CanvasTemplate[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // anthropic | openai | google
  encryptedKey String // AES-256-GCM, never returned to the client
  last4        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

model Project {
  id             String         @id @default(cuid())
  name           String         @default("Untitled Project")
  description    String?
  canvasJsonPath String?
  thumbnailUrl   String?
  shareToken     String?  @unique
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaborators  Collaborator[]
  generations    AIGeneration[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
}

model Collaborator {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  role      Role     @default(EDITOR)
  title     String? // free-text discipline/role set by the owner (e.g. "Backend Lead", "Security")
  createdAt DateTime @default(now())

  @@unique([projectId, email])
  @@index([userId])
  @@index([projectId])
}

model AIGeneration {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prompt    String
  type      String   @default("generation") // generation | url-analysis | critique | refinement
  status    String   @default("pending")    // pending | running | completed | failed
  result    Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/**
 * User-saved canvas templates.
 * isPublic=true → visible in the template picker to all users.
 * isPublic=false → private, only visible to the creator.
 */
model CanvasTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String   @default("custom")  // web | data | infra | mobile | custom
  isPublic    Boolean  @default(false)
  schema      Json     // spi-schema.json structure
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isPublic])
}

model TaskRun {
  id        String   @id @default(cuid())
  runId     String   @unique
  projectId String
  userId    String
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([projectId, userId])
}
